BT 1 0 0 1 0 57.4 Tm /F5 6.6 Tf 8 TL (F = a * 9/5 + 32                       # vectorised conversion, no loop) Tj T* (print\("Fahrenheit:\\n", F\)) Tj T* (change = a[:, 1:] - a[:, :-1]          # day-to-day change by slicing) Tj T* (print\("Day-to-day change, shape", change.shape, "\\n", change\)) Tj T* (means = a.mean\(axis=1, keepdims=True\)  # shape \(4,1\)) Tj T* (dev = a - means                        # \(4,5\) - \(4,1\) -> \(4,5\)) Tj T* (print\("shapes:", a.shape, "-", means.shape, "->", dev.shape\)) Tj T* (print\(dev.round\(2\)\)) Tj T* ET
